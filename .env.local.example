# AdForge AI — entorno local
# Copiar a `.env.local` (ya está en .gitignore).

# ────────────────────────────────────────────────────────────────────────────
# PROVEEDOR DE IA  (el switch principal)
#   meta → el Meta Model API del hackathon. TODO el pipeline sale de ahí:
#          `muse-spark-1.3` hace la pasada de visión sobre la foto, escribe el
#          copy/SEO/audiencias/escenas y `muse-image-1.0` genera los 3 flyers.
#          UNA sola llave habilita los tres modelos. Requiere MUSE_IMAGE_API_KEY.
#   demo → fixtures deterministas, sin red (smoke test y UI base).
# Cualquier otro valor, o `meta` sin llave, cae a `demo` en vez de reventar a
# mitad de la corrida.
# ────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=meta

# ────────────────────────────────────────────────────────────────────────────
# MODO LEGADO: si NO definís AI_PROVIDER, manda DEMO_MODE.
# true = demo; false + MUSE_IMAGE_API_KEY = meta; false sin llave = demo.
# ────────────────────────────────────────────────────────────────────────────
DEMO_MODE=true

# ── Meta Model API ───────────────────────────────────────────────────────────
# Es el motor del proyecto. Los ids, rutas y shapes de abajo están VERIFICADOS
# contra la llave real el 26-oct (las sondas quedaron en `.probe/`).
#
# Una sola llave habilita los tres modelos: `GET https://api.meta.ai/v1/models`
# con ella devuelve muse-image-1.0, muse-spark-1.3, sam-3.1, muse-wonder-1.0 y
# muse-voice-transcribe-1.0. Muse Image cobra $0.01 por imagen (plano, sin
# importar el razonamiento) → 3 flyers = $0.03.

# La llave del Meta Model API (formato LLM_...). Los tres modelos la leen de
# acá; no existe una por modelo.
MUSE_IMAGE_API_KEY=

# Modelo de imagen para los 3 flyers. Se usa por POST /v1/images/edits
# (multipart model+prompt+image+size → data[0].b64_json): es el único camino
# img2img que acepta la foto real. `/v1/images/generations` con imagen da
# "unknown parameter": ese endpoint es solo text-to-image.
MUSE_IMAGE_MODEL=muse-image-1.0
# Cuadro del flyer "WxH". 1536x2048 = 3:4 en 2K, tipografía legible.
MUSE_IMAGE_SIZE=1536x2048
# Presupuesto por flyer en ms. Medido: 18-25 s por pieza con copy horneado.
MUSE_IMAGE_TIMEOUT_MS=90000

# Modelo de texto/visión (copy, SEO, audiencias, escenas y la pasada de visión
# sobre la foto). Va por POST /v1/responses con text.format=json_schema.
# OJO: `sam-3.1` existe en el catálogo pero responde 200 con output_text vacío
# y no hay endpoint de máscaras (/v1/segmentations, /v1/masks → 404), así que
# el bounding box del producto lo saca muse-spark de la foto, no SAM.
MUSE_SPARK_MODEL=muse-spark-1.3
# muse-spark razona antes de contestar (576 tokens de razonamiento para 3 hooks
# en la prueba), así que sus pasos necesitan más aire.
META_TEXT_TIMEOUT_MS=90000

# Límites del route handler.
MAX_UPLOAD_MB=8
