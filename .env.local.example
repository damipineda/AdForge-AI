# AdForge AI — configuración local
# Copiá este archivo como .env.local. No compartas ni subas tu llave.

# meta: utiliza Muse Spark y Muse Image mediante Meta Model API.
# demo: utiliza datos locales sin llamadas de inferencia.
AI_PROVIDER=demo

# Activá AI_PROVIDER=meta y agregá tu llave para usar Muse.
MUSE_IMAGE_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_IMAGE_MODEL=muse-image-1.0

# Formatos de salida y límites de tiempo, opcionales.
MUSE_IMAGE_SIZE_FEED=1080x1350
MUSE_IMAGE_SIZE_STORY=1080x1920
MUSE_IMAGE_TIMEOUT_MS=90000
META_TEXT_TIMEOUT_MS=90000
